# Copie este arquivo para .env e preencha com os valores reais.
# Depois rode: node gerar-env.js

# Painel do Supabase > Project Settings > API > "Project URL"
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave "anon" / "publishable" (protegida pelas regras RLS).
# NUNCA coloque aqui a chave "service_role".
SUPABASE_ANON_KEY=SUA-CHAVE-PUBLISHABLE

# Tabela onde as mensagens são salvas
SUPABASE_TABELA=contatos

# Webhook do n8n que também recebe os dados do formulário
WEBHOOK_URL=https://SEU-WEBHOOK
