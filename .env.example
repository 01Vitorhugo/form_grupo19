# Copie este arquivo para .env e preencha com os valores reais.
# Depois rode: node gerar-env.js

# Supabase do Grupo19. O site chama a função /functions/v1/contato-enviar,
# que grava no schema "contato". Nenhuma chave do banco vai para o site.
SUPABASE_URL=https://supabase.grupo19.app

# Webhook do n8n que também recebe os dados do formulário
WEBHOOK_URL=https://SEU-N8N/webhook/...
